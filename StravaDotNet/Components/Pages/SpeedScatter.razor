@page "/detailed-activity-plots"
@using Data.Models.Strava
@using StravaDotNet.ViewModels
@using Newtonsoft.Json
@using StravaDotNet.Components.Services
@inject PlottingHelperService plottingHelperService
@inject NavigationManager Navigation
@inject AuthState AuthState
@inject DataRetrievalService dataRetrievalService
@inject PlottingHelperService plottingHelperService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<form class="load-data-form">
    <button type="button" class="btn btn-secondary" margin-right:30px @onclick="LoadData">Load Data</button>
</form>
@if (activityVms != null)
{
    <div class="canvas-container">
        @foreach (var canvasId in canvasIds)
        {
            <details class="canvas-details" open="@detailsOpen.Contains(canvasId)" @ontoggle="() => OnToggle(canvasId)">
                <summary class="canvas-summary">@GetTitle(canvasId)</summary>
                <div class="canvas-wrapper" id="@($"{canvasId}-wrapper")">
                    <canvas id="@canvasId"></canvas>
                </div>
            </details>
        }
    </div>
}

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            bool isLoggedIn = await AuthState.GetIsLoggedInAsync();
            if (!isLoggedIn)
            {
                Navigation.NavigateTo("/account/login", true);
            }
            else
            {
                StateHasChanged();
            }
        }
    }

    private List<ActivityVm>? activityVms;
    private readonly List<string> canvasIds = new()
    {
        "scatterPlotRun",
        "scatterPlotRide",
        "heartRatePlotRun",
        "heartRatePlotRide",
        "stackedBarsMonths",
        "stackedBarsHours",
        "cumulativeRunDistance",
        "cumulativeRideDistance",
        "cumulativeSwimDistance",
        "cumulativeHoursTotal"
    };
    private HashSet<string> initializedCanvasIds = new();
    private HashSet<string> detailsOpen = new();
    private bool chartsAutoInitialized = false;

    private async Task LoadData()
    {
        activityVms = await dataRetrievalService.GetAllActivityVmsAsync();

        // Check viewport width to decide whether to expand sections and auto-init charts
        var width = await JSRuntime.InvokeAsync<int>("blazorHelpers.getWindowWidth");

        detailsOpen.Clear();
        if (width >= 768)
        {
            // Desktop/tablet: open all sections and auto-initialize charts
            foreach (var id in canvasIds) detailsOpen.Add(id);
            StateHasChanged(); // ensure details are open in DOM before plotting
            await PlotAllCharts();
            await JSRuntime.InvokeVoidAsync("blazorHelpers.registerChartResizeObservers", canvasIds);
            chartsAutoInitialized = true;
        }
        else
        {
            // Mobile: keep collapsed, initialize on demand when user opens a section
            chartsAutoInitialized = false;
            StateHasChanged();
        }
    }

    private async Task PlotAllCharts()
    {
        if (activityVms != null)
        {
            var tasks = new List<Task>()
            {
                PlotChartIfNotInitialized("scatterPlotRun", () => PlotSpeed("Run")),
                PlotChartIfNotInitialized("scatterPlotRide", () => PlotSpeed("Ride")),
                PlotChartIfNotInitialized("heartRatePlotRun", () => PlotHeartRate("Run")),
                PlotChartIfNotInitialized("heartRatePlotRide", () => PlotHeartRate("Ride")),
                PlotChartIfNotInitialized("stackedBarsMonths", PlotMonthlyActivities),
                PlotChartIfNotInitialized("stackedBarsHours", PlotHourlyActivities),
                PlotChartIfNotInitialized("cumulativeRunDistance", () => PlotCumulativeActivities("Run")),
                PlotChartIfNotInitialized("cumulativeRideDistance", () => PlotCumulativeActivities("Ride")),
                PlotChartIfNotInitialized("cumulativeSwimDistance", () => PlotCumulativeActivities("Swim")),
                PlotChartIfNotInitialized("cumulativeHoursTotal", () => PlotCumulativeActivities("All"))
            };
            await Task.WhenAll(tasks);
        }
    }

    private async Task PlotChartIfNotInitialized(string canvasId, Func<Task> plotFunction)
    {
        if (!initializedCanvasIds.Contains(canvasId))
        {
            await plotFunction();
            initializedCanvasIds.Add(canvasId);
            // register resize observer for this particular chart so it adapts to size changes
            await JSRuntime.InvokeVoidAsync("blazorHelpers.registerChartResizeObservers", new[] { canvasId });
        }
    }

    private async Task OnToggle(string canvasId)
    {
        // details toggled; check if it's open and act accordingly
        var isOpen = await JSRuntime.InvokeAsync<bool>("blazorHelpers.isDetailsOpen", canvasId);
        if (isOpen)
        {
            // mark open so markup reflects state if user resizes later
            detailsOpen.Add(canvasId);

            if (!initializedCanvasIds.Contains(canvasId))
            {
                await EnsurePlotInitialized(canvasId);
            }
            else
            {
                // If chart already exists, request a resize so it fills the visible area
                await JSRuntime.InvokeVoidAsync("blazorHelpers.resizeChart", canvasId);
            }
        }
        else
        {
            detailsOpen.Remove(canvasId);
        }
    }

    private async Task EnsurePlotInitialized(string canvasId)
    {
        switch (canvasId)
        {
            case "scatterPlotRun":
                await PlotChartIfNotInitialized(canvasId, () => PlotSpeed("Run"));
                break;
            case "scatterPlotRide":
                await PlotChartIfNotInitialized(canvasId, () => PlotSpeed("Ride"));
                break;
            case "heartRatePlotRun":
                await PlotChartIfNotInitialized(canvasId, () => PlotHeartRate("Run"));
                break;
            case "heartRatePlotRide":
                await PlotChartIfNotInitialized(canvasId, () => PlotHeartRate("Ride"));
                break;
            case "stackedBarsMonths":
                await PlotChartIfNotInitialized(canvasId, PlotMonthlyActivities);
                break;
            case "stackedBarsHours":
                await PlotChartIfNotInitialized(canvasId, PlotHourlyActivities);
                break;
            case "cumulativeRunDistance":
                await PlotChartIfNotInitialized(canvasId, () => PlotCumulativeActivities("Run"));
                break;
            case "cumulativeRideDistance":
                await PlotChartIfNotInitialized(canvasId, () => PlotCumulativeActivities("Ride"));
                break;
            case "cumulativeSwimDistance":
                await PlotChartIfNotInitialized(canvasId, () => PlotCumulativeActivities("Swim"));
                break;
            case "cumulativeHoursTotal":
                await PlotChartIfNotInitialized(canvasId, () => PlotCumulativeActivities("All"));
                break;
            default:
                break;
        }
    }

    private string GetTitle(string canvasId)
    {
        return canvasId switch
        {
            "scatterPlotRun" => "Run speed (km/h)",
            "scatterPlotRide" => "Ride speed (km/h)",
            "heartRatePlotRun" => "Run heart rate",
            "heartRatePlotRide" => "Ride heart rate",
            "stackedBarsMonths" => "Activities by month",
            "stackedBarsHours" => "Activities by hour",
            "cumulativeRunDistance" => "Cumulative run distance",
            "cumulativeRideDistance" => "Cumulative ride distance",
            "cumulativeSwimDistance" => "Cumulative swim distance",
            "cumulativeHoursTotal" => "Cumulative time (all)",
            _ => canvasId
        };
    }

    private async Task PlotSpeed(string activityType)
    {
        if (activityVms == null || !activityVms.Any(a => a.Activity.Type == activityType))
        {
            return;
        }
        var selectedActivities = activityVms.Where(a => a.Activity.Type == activityType).ToList();
        var data = plottingHelperService.PrepareScatterPlotData(
            selectedActivities,
            a => a.Activity.Distance / 1000,
            a => (a.Activity.Distance / a.Activity.MovingTime) * 3.6,
            a => PlottingHelperService.GetColorForDate(a.Activity.StartDate, activityVms.Min(a => a.Activity.StartDate), activityVms.Max(a => a.Activity.StartDate)),
            a => DateOnly.FromDateTime((DateTime)a.Activity.StartDate)
        );

        await JSRuntime.InvokeVoidAsync("plotScatterChart", data, $"scatterPlot{activityType}", $"Average {activityType.ToLower()} speed (km/h)");
    }

    private async Task PlotHeartRate(string type)
    {
        if (activityVms == null || !activityVms.Any(a => a.Activity.Type == type))
        {
            return;
        }
        var selectedActivities = activityVms.Where(a => a.AverageHeartRate != 0 && a.Activity.Type == type).ToList();
        var data = plottingHelperService.PrepareScatterPlotData(
            selectedActivities,
            a => a.Activity.Distance / 1000,
            a => a.AverageHeartRate,
            a => PlottingHelperService.GetColorForDate(a.Activity.StartDate, activityVms.Min(a => a.Activity.StartDate), activityVms.Max(a => a.Activity.StartDate)),
            a => DateOnly.FromDateTime((DateTime)a.Activity.StartDate)
        );

        await JSRuntime.InvokeVoidAsync("plotScatterChart", data, $"heartRatePlot{type}", $"Average {type.ToLower()} heart rate");
    }

    private async Task PlotMonthlyActivities()
    {
        if (activityVms == null || !activityVms.Any(a => a.Activity.Type == "Run" || a.Activity.Type == "Ride" || a.Activity.Type == "Swim"))
        {
            return;
        }
        List<ActivityVm> selectedActivities = activityVms
            .Where(a => a.Activity.Type == "Run" || a.Activity.Type == "Ride" || a.Activity.Type == "Swim")
            .ToList();
        var data = plottingHelperService.PrepareMonthlyBarChartData(selectedActivities);
        await JSRuntime.InvokeVoidAsync("plotStackedBarChart", data, "stackedBarsMonths", "Year-Month");
    }

    private async Task PlotHourlyActivities()
    {
        if (activityVms == null || !activityVms.Any(a => a.Activity.Type == "Run" || a.Activity.Type == "Ride" || a.Activity.Type == "Swim"))
        {
            return;
        }
        List<ActivityVm> selectedActivities = activityVms
            .Where(a => a.Activity.Type == "Run" || a.Activity.Type == "Ride" || a.Activity.Type == "Swim")
            .ToList();
        var data = plottingHelperService.PrepareHourlyBarChartData(selectedActivities);
        await JSRuntime.InvokeVoidAsync("plotStackedBarChart", data, "stackedBarsHours", "Hour of day");
    }

    private async Task PlotCumulativeActivities(string activityType)
    {
        List<ActivityVm> selectedActivities = new();
        var data = "";
        string plotId = "";
        string yAxisTitle = "";
        if (activityType == "All" && activityVms != null)
        {
            selectedActivities = activityVms;
            data = plottingHelperService.PrepareCumulativeTimeData(selectedActivities);
            plotId = "cumulativeHoursTotal";
            yAxisTitle = "Cumulative time (hours)";
        }
        else if (activityVms != null)
        {
            selectedActivities = activityVms.Where(a => a.Activity.Type == activityType).ToList();
            data = plottingHelperService.PrepareCumulativeDistanceData(selectedActivities);
            plotId = $"cumulative{activityType}Distance";
            yAxisTitle = $"Cumulative {activityType.ToLower()} distance (km)";
        }
        await JSRuntime.InvokeVoidAsync("plotLineChart", data, plotId, "Day/Month", yAxisTitle);
    }

    public async ValueTask DisposeAsync()
    {
        await JSRuntime.InvokeVoidAsync("blazorHelpers.disposeChartResizeObservers");
    }
}

<style>
    .load-data-form {
        margin-bottom: 20px;
    }

    .canvas-container {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .canvas-details {
        border: 1px solid rgba(0,0,0,0.06);
        border-radius: 6px;
        padding: 8px;
        background: #fff;
    }

    .canvas-summary {
        font-weight: 600;
        cursor: pointer;
        padding: 6px 4px;
        list-style: none;
    }

    .canvas-wrapper {
        width: 100%;
        /* Ensure a stable visible area even when details was collapsed */
        min-height: 320px;
        /* Use aspect-ratio as fallback where supported */
        aspect-ratio: 16 / 9;
        padding: 8px 0;
        box-sizing: border-box;
    }

    canvas {
        width: 100% !important;
        height: 100% !important;
        display: block;
        background: white;
    }

    @@media (min-width: 768px) {
        .canvas-container {
            flex-direction: row;
            flex-wrap: wrap;
            gap: 20px;
        }

        .canvas-details {
            flex: 1 1 calc(50% - 20px);
            max-width: calc(50% - 20px);
        }

        .canvas-wrapper {
            min-height: 360px;
        }
    }
</style>